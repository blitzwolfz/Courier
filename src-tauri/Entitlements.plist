<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for WebView JavaScript execution -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Required for WebView (V8/JavaScriptCore) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required for loading bundled dylibs and plugins -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Required for sending HTTP/WebSocket/gRPC requests to user-specified endpoints -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Required for the gRPC and WebSocket servers to accept incoming connections -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Required for file open/save dialogs (proto files, Postman import/export) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
